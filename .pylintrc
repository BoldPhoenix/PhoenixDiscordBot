[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-instance-attributes,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    invalid-name,
    fixme

[FORMAT]
max-line-length=100

[BASIC]
good-names=i,j,k,ex,Run,_,id,db

[DESIGN]
max-args=10
max-attributes=15
