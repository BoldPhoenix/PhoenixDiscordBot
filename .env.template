# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Discord Bot Token (Required)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Guild ID (Required)
DISCORD_GUILD_ID=your_guild_id_here

# All other configuration (servers, channels, roles) is managed through:
# - Database (use /setup, /addserver commands in Discord)
# - Bot commands (use /setchannels, /setadminrole, etc.)

# Bot Settings (Optional - defaults will be used if not specified)
BOT_PREFIX=!
STATUS_UPDATE_INTERVAL=60
CHAT_POLL_INTERVAL=5
DATABASE_PATH=bot.db
LOG_LEVEL=INFO