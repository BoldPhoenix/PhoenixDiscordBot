# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_server_id_here
CHAT_CHANNEL_ID=channel_id_for_cross_chat
STATUS_CHANNEL_ID=channel_id_for_status_updates
ADMIN_ROLE_ID=role_id_for_admin_commands

# ARK Server Configuration (JSON format)
# Each server needs: name, host, rcon_port, rcon_password
# For bidirectional chat, add log_path pointing to the server's ShooterGame.log
ARK_SERVERS=[
  {
    "name": "Aberration",
    "host": "127.0.0.1",
    "rcon_port": 27020,
    "rcon_password": "your_rcon_password",
    "chat_enabled": true,
    "log_path": "C:/ARK/ShooterGame/Saved/Logs/ShooterGame.log"
  },
  {
    "name": "The Island",
    "host": "127.0.0.1",
    "rcon_port": 27021,
    "rcon_password": "your_rcon_password",
    "chat_enabled": true,
    "log_path": "C:/ARK/ShooterGame/Saved/Logs/ShooterGame.log"
  }
]# Bot Configuration
BOT_PREFIX=!
CURRENCY_NAME=Phoenix Coins
CURRENCY_EMOJI=🪙
STATUS_UPDATE_INTERVAL=60
CHAT_POLL_INTERVAL=5

# Database
DATABASE_PATH=ark_bot.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ─────────────────────────────────────────────────────────────────────────────
# BILLING (optional, and OFF by default — leave these blank)
#
# The bot originally ran as a hosted service with free/premium tiers sold through Stripe.
# Self-hosted, all of that is switched off and every feature is unlocked. You only need these
# if you intend to run this bot as a paid service for other people, which is entirely your
# undertaking — legal, tax and support included.
# STRIPE_SECRET_KEY=
# STRIPE_PREMIUM_LINK=
# STRIPE_LIFETIME_LINK=
